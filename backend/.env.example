PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bloodbank
JWT_SECRET=your_super_strong_64_character_random_jwt_secret_hex_key_here
ALLOWED_ORIGINS=http://localhost:5173
NODE_ENV=development

# SMTP Email Configuration (for Password Reset OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=LifeDrop Blood Bank <your_email@gmail.com>
